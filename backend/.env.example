GROQ_API_KEY=your_groq_key_here
# Check console.groq.com/docs/models if this one is ever deprecated
GROQ_MODEL=llama-3.3-70b-versatile

# Whisper size: tiny | base | small  (base is a good CPU default)
WHISPER_SIZE=base

# 1 = also run wav2vec2 speech-emotion on voice input (~1.2 GB download). 0 = text-only emotion.
USE_AUDIO_MODEL=1
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.2